#!/bin/bash
# ============================================================
#  ทางลัด Mac → แผงสวิตช์ SO Workers (ไม่เปิด Terminal ค้าง)
#  เดิมเคยเปิด Terminal 2 บาน — ตอนนี้ใช้แผงสวิตช์แทน
# ============================================================
cd "$(dirname "$0")" || exit 1
exec "$PWD/SO-Workers.command"
